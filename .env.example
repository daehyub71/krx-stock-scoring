# krx-stock-scoring — 환경변수 이름만 담는다. 값은 .env에 넣는다 (.gitignore 대상).
# CI·Actions에서는 리포지토리 Secrets로 주입한다.

# 상위 공유 Supabase (ksc_*·ksa_*) — 읽기 전용으로만 연다 (세션 default_transaction_read_only=on)
UPSTREAM_DATABASE_URL=

# kss 전용 Supabase — Session pooler URI (포트 5432. Actions 러너는 IPv6 직접 연결 불가)
KSS_DATABASE_URL=

# OpenDART — 인증키가 URL 쿼리에 실린다. 예외·로그에 URL을 통째로 찍지 않는다
DART_API_KEY=

# kss 전용 롤 비밀번호 — scripts/apply_schema.py가 롤에 설정한다 (무작위 생성 권장)
KSS_BATCH_PASSWORD=
KSS_READER_PASSWORD=

# KRX 로그인 — pykrx가 import 시 자동 로그인 (M2 PER/PBR)
KRX_ID=
KRX_PW=

# 네이버 검색 API — 뉴스 9점 (M3). 개발자센터 애플리케이션의 클라이언트 ID/시크릿
# 표준 라이브러리로 직접 호출한다 (SPEC v2.9). 하루 25,000회 한도 · 전 종목 약 2,585회
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
